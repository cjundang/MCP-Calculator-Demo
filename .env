# =============================================================================
# MCP Calculator Demo — central configuration
# All tunable values live here. Code reads them via config.py.
# =============================================================================

# --- LLM provider: primary = Ollama (local), fallback = OpenRouter ---
# Primary: local Ollama, OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_PROBE_TIMEOUT=2.0

# Fallback: OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- MCP servers (TCP / streamable-http) ---
MCP_HOST=127.0.0.1
MCP_TRANSPORT=streamable-http
MCP_HTTP_PATH=/mcp
ADD_PORT=8001
SUBTRACT_PORT=8002
MULTIPLY_PORT=8003
DIVIDE_PORT=8004

# --- Launcher ---
SERVER_SHUTDOWN_TIMEOUT=5

# --- Behavior ---
# DEBUG=1 prints what the LLM returned. Leave empty to disable.
DEBUG=

# System prompt sent to the LLM (single line)
SYSTEM_PROMPT=You are a calculator router. The user sends a message in Thai or English describing a single arithmetic operation on two numbers. Call exactly one of the provided tools with the two numbers as `a` and `b`, preserving their order as written. Do not answer in text; always call a tool.
